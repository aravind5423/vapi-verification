# ─── Vapi Web SDK config ────────────────────────────────────────────────────
# Both values are browser-safe (public) and are inlined into the bundle by Vite
# at build time. Do NOT put the Vapi PRIVATE key here — it is never used client-side.

# Public API key — Vapi Dashboard → API Keys → Public Key.
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key

# The dashboard-managed assistant's ID — Vapi Dashboard → Assistants → Freya → copy ID.
VITE_VAPI_ASSISTANT_ID=your_assistant_id

# ─── Server-side only — NOT bundled to the browser ──────────────────────────
# Used by the /api/outcome serverless function to fetch a call's authoritative
# outcome from Vapi when the in-call set_outcome is missed. This is your PRIVATE
# key — never prefix it with VITE_ (that would inline it into the client bundle).
# Set it in Vercel (Project → Settings → Environment Variables) for production,
# and keep it in .env.local for `vercel dev`. Also used by the scripts.
VAPI_PRIVATE_KEY=your_vapi_private_key
