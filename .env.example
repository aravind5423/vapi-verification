# ─── Vapi credentials ─────────────────────────────────────────────────────────
# Your Vapi private API key (from https://dashboard.vapi.ai → Account → API Keys)
VAPI_API_KEY=your_vapi_api_key_here

# The Vapi phone number ID to place outbound calls from
# (from https://dashboard.vapi.ai → Phone Numbers)
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# ─── Webhook base URL ──────────────────────────────────────────────────────────
# The public URL of your deployed Vercel app (no trailing slash)
# For local dev use ngrok: ngrok http 3000  →  e.g. https://abc123.ngrok.io
WEBHOOK_BASE_URL=https://your-vercel-domain.vercel.app

# ─── Upstash Redis (optional — for persistent state in production) ────────────
# If not set, the server falls back to an in-memory Map (fine for local dev).
# Create a free Redis DB at https://upstash.com, then link it to Vercel under
# Integrations → Upstash. The env vars are auto-injected into your project.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
